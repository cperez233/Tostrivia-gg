{
  "name": "tostrivia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "videos": "node scripts/fetch-videos.mjs",
    "videos:sin-key": "node scripts/find-videos.mjs",
    "check:bank": "node scripts/check-bank.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "peer:local": "peerjs --port 9000 --path /tostrivia"
  },
  "dependencies": {
    "@fontsource/dela-gothic-one": "^5.3.0",
    "@fontsource/zen-kaku-gothic-new": "^5.3.0",
    "framer-motion": "^11.18.2",
    "peerjs": "^1.5.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "peer": "^1.0.2",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
